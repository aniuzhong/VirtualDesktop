// Virtual Desktop resources. Configured by CMake (@ONLY).
//
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

IDR_MAINFRAME           ICON                    "@WILX_APP_ICON@"

/////////////////////////////////////////////////////////////////////////////
//
// Manifest
//

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@WILX_APP_MANIFEST@"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_PANEL DIALOGEX 0, 0, 160, 110
STYLE DS_SETFONT | DS_SETFOREGROUND | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW | WS_EX_WINDOWEDGE
CAPTION "Virtual Desktop"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX        IDC_DESKTOP_LIST,7,7,146,72,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON  "&New",IDC_NEW,7,86,48,16
    PUSHBUTTON     "&Switch To",IDC_SWITCH,60,86,56,16
END

IDD_RUN DIALOGEX 0, 0, 260, 66
STYLE DS_SETFONT | DS_SETFOREGROUND | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW | WS_EX_WINDOWEDGE | WS_EX_TOPMOST
CAPTION "Run"
FONT 9, "Segoe UI"
BEGIN
    LTEXT          "Type the name of a program, folder, document, or Internet resource, and Windows will open it for you.",IDC_PROMPT,7,6,246,18
    LTEXT          "&Open:",-1,7,31,24,9
    EDITTEXT       IDC_COMMAND,34,29,140,13,ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON  "&OK",IDOK,180,28,30,14
    PUSHBUTTON     "&Browse...",IDC_BROWSE,213,28,40,14
END

IDD_NEW_DESKTOP DIALOGEX 0, 0, 160, 52
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Desktop"
FONT 9, "Segoe UI"
BEGIN
    LTEXT          "&Desktop name:",-1,7,7,54,9
    EDITTEXT       IDC_NEW_NAME,7,19,146,13,ES_AUTOHSCROLL
    DEFPUSHBUTTON  "OK",IDOK,7,34,50,14
    PUSHBUTTON     "Cancel",IDCANCEL,62,34,50,14
END

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "FileDescription", "Virtual Desktop"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Virtual Desktop"
            VALUE "OriginalFilename", "Virtual Desktop.exe"
            VALUE "ProductName", "Virtual Desktop"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
