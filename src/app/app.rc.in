IDR_MAINFRAME           ICON                    "@WILX_APP_ICON@"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Virtual Desktop"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "Virtual Desktop Version 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Created By :- Mallinath Karkanti \n\r\t         (Mallinathk@gmail.com)",IDC_STATIC,40,25,163,23
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,16,WS_GROUP
END

IDD_VIRTUALDESKTOP_DIALOG DIALOGEX 0, 0, 306, 109
STYLE DS_SYSMODAL | DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST | WS_EX_WINDOWEDGE | WS_EX_APPWINDOW
CAPTION "Virtual Desktop !"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Manage Desktops",IDC_CREATE_NEW_DESKTOP,2,3,301,99
    LISTBOX         IDC_DESKTOP_LIST,7,13,105,84,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Desktop Name",IDC_STATIC,117,64,47,8
    EDITTEXT        IDC_DESKTOP_NAME,172,62,127,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "&Add",IDC_ADD_NEW_DESKTOP,117,81,37,16
    PUSHBUTTON      "&Switch to",IDC_SWITCH_TO_DESKTOP,156,81,37,16,WS_DISABLED
    CONTROL         "&Confirm ""Desktop Switch"".",IDC_VERIFY_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,117,47,97,11
END


